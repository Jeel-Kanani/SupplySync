NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/supplysync?retryWrites=true&w=majority&appName=<app-name>
CORS_ORIGIN=http://localhost:3000
AUTOMATION_SCHEDULER_ENABLED=true

TELEGRAM_API_ID=<your_api_id>
TELEGRAM_API_HASH=<your_api_hash>
TELEGRAM_SESSION=<your_gramjs_session_string>
TELEGRAM_BOT_TOKEN=<your_bot_token>

TELEGRAM_INTELLIGENCE_ENABLED=true
TELEGRAM_AUTO_APPLY_CONFIDENCE=90
TELEGRAM_REVIEW_CONFIDENCE=70
REDIS_URL=redis://127.0.0.1:6379
